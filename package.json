{
  "name": "excalidraw-ui",
  "version": "0.1.4",
  "private": true,
  "scripts": {
    "hosts:flush": "sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder",
    "caddy:clean": "sudo killall caddy; rm -rf ~/Library/Application\\ Support/Caddy",
    "caddy": "caddy run --config Caddyfile",
    "dev": "lsof -ti:3076 | xargs kill -9 && next dev -p 3076",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pull": "dotenv -- pnpm add @juki-team/commons@latest @juki-team/base-ui@latest"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ably/spaces": "^0.5.2",
    "@ai-sdk/react": "^3.0.97",
    "@juki-team/base-ui": "^1.4.45",
    "@juki-team/commons": "^0.0.1072",
    "@vercel/analytics": "^1.6.1",
    "ably": "^2.17.1",
    "ai": "^6.0.95",
    "mermaid": "^11.12.3",
    "next": "16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "swr": "^2.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.0.0",
    "eslint-config-next": "16.1.6",
    "prettier": "^3.8.1",
    "typescript": "^5"
  }
}
