{
  "name": "mermaid-ui",
  "version": "0.1.5",
  "private": true,
  "scripts": {
    "hosts:flush": "sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder",
    "caddy:clean": "sudo killall caddy; rm -rf ~/Library/Application\\ Support/Caddy",
    "caddy": "caddy run --config Caddyfile",
    "dev": "lsof -ti:3076 | xargs kill -9 && next dev -p 3076",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "git:push": "git push origin main && git push origin --tags",
    "pull": "dotenv -- pnpm add @juki-team/commons@latest @juki-team/base-ui@latest",
    "push": "pnpm version patch && pnpm git:push;"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ably/spaces": "^0.5.2",
    "@ai-sdk/react": "^3.0.118",
    "@juki-team/base-ui": "^1.4.68",
    "@juki-team/commons": "^0.1.4",
    "@vercel/analytics": "^2.0.1",
    "ably": "^2.20.0",
    "ai": "^6.0.116",
    "dom-to-image-more": "^3.7.2",
    "mermaid": "^11.13.0",
    "next": "16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "swr": "^2.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.0.3",
    "eslint-config-next": "16.1.6",
    "prettier": "^3.8.1",
    "typescript": "^5"
  }
}
